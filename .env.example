# =============================================================================
# Verdant Tongues design system — environment template
# =============================================================================
#
# HOW THIS FILE IS USED
#   Bootstrapped from core's docs/design-system.env.example; lives in the
#   design-system repository as `.env.example`. Committed, PLACEHOLDERS ONLY.
#   Copy to `.env` to run the Figma import on your own machine.
#
# WHAT IS DELIBERATELY ABSENT
#   - Nothing for CI. CI builds from the committed tokens and never reads Figma
#     (design-system.md → §6).
#   - Nothing public. Tokens, fonts and icons are files in the repository.
#
# CURRENT STATE
#   The repository is not scaffolded, so nothing reads these yet.
#
# MAINTENANCE
#   Adding a variable to the code means adding it here in the same change,
#   with a comment naming what reads it and why.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Figma — source B, the REST read (design-system.md → §2)
# -----------------------------------------------------------------------------

# [SECRET] A Figma personal access token, READ-ONLY, minted by the developer
# running the import. Read by `npm run import`. Never in CI, never committed,
# never pasted into a chat or a file other than your own `.env`. Revoke it in
# Figma when you no longer run imports.
FIGMA_ACCESS_TOKEN=

# The key of the Figma file holding VT's design (the part of the file URL
# after /design/). An identifier, not a secret.
FIGMA_FILE_KEY=PLACEHOLDER
