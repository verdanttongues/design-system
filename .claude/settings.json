{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run styleguide)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git clean *)",
      "Bash(git worktree *)",
      "Bash(git remote *)",
      "Bash(git config *)",
      "Bash(git -C *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(gh workflow *)",
      "EnterWorktree",
      "ExitWorktree"
    ]
  },
  "extraKnownMarketplaces": {
    "verdanttongues": {
      "source": {
        "source": "github",
        "repo": "verdanttongues/claude-shared"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "vt-shared@verdanttongues": true
  }
}
