{
  "name": "@verdanttongues/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "The single source of design truth for VT's two public sites (core A388): DTCG tokens built to CSS, self-hosted fonts and icons",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.*.json": "./dist/tokens.*.json",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "fonts/",
    "icons/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check:dist": "node scripts/check-dist.js",
    "test": "node --test \"test/*.test.js\"",
    "styleguide": "node scripts/styleguide.js"
  },
  "devDependencies": {
    "style-dictionary": "5.8.0"
  }
}
